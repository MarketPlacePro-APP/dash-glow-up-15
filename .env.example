# Names only. Real values stay in Vercel production env and macOS Keychain.
# Do not put passwords or tokens in git.

# Dashboard Basic Auth (middleware.ts / api/_lib/security.ts)
TLWB_AUTH_USERNAME=
TLWB_AUTH_PASSWORD=

# Studio refresh worker Bearer token
TLWB_WORKER_TOKEN=

# Optional accounting API token
TLWB_DAVID_API_TOKEN=

# Refresh-now gist queue
TLWB_REFRESH_GIST_ID=
TLWB_REFRESH_GIST_TOKEN=

# Owner wrapper / daily refresh (set by Harlow cron, not Vercel)
TLWB_KPI_DEPLOY=
TLWB_KPI_CHANGE_AWARE=
TLWB_KPI_PREVIOUS_FINGERPRINT=
TLWB_KPI_AUTH_USERNAME=
TLWB_KPI_AUTH_PASSWORD=
TLWB_KPI_PYTHON_BIN=
TLWB_SLACK_SNAPSHOT=
TLWB_SOURCE_ARCHIVE_DB=

# Keychain items used on Mac Studio (not env files)
# harlow.tlwb-kpi.team-password / account tlwb-team
# harlow.tlwb-kpi.worker-token / account worker
# harlow.tlwb-kpi.refresh-gist-token / account gist
